@page "/create-support"
@rendermode InteractiveServer
@using SupportWebApp.Models
@using SupportWebApp.Services
@inject CosmosDbService CosmosDbService

<h1>Opret supportbesked</h1>

<EditForm Model="@supportMessage" OnValidSubmit="@CreateSupportMessage" FormName="createSupportForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Navn</label>
        <InputText class="form-control" @bind-Value="supportMessage.Name" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="supportMessage.Email" />
    </div>

    <div class="mb-3">
        <label>Telefon</label>
        <InputText class="form-control" @bind-Value="supportMessage.Phone" />
    </div>

    <div class="mb-3">
        <label>Beskrivelse</label>
        <InputTextArea class="form-control" @bind-Value="supportMessage.Description" />
    </div>

    <div class="mb-3">
        <label>Kategori</label>
        <InputText class="form-control" @bind-Value="supportMessage.Category" />
    </div>

    <button type="submit" class="btn btn-primary">
        Send supportbesked
    </button>
</EditForm>

@if (messageCreated)
{
    <p class="text-success mt-3">Supportbeskeden er oprettet!</p>
}

@code {
    private SupportMessage supportMessage = new();
    private bool messageCreated = false;

    private async Task CreateSupportMessage()
    {
        supportMessage.Id = Guid.NewGuid().ToString();
        supportMessage.DateTime = DateTime.Now;

        await CosmosDbService.AddSupportMessageAsync(supportMessage);

        messageCreated = true;
        supportMessage = new SupportMessage();
    }
}